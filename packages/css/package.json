{
  "name": "@uxiora/css",
  "version": "1.0.0-rc.1",
  "description": "A modern, utility-first CSS framework built with SCSS.",
  "license": "MIT",
  "author": "Saklain Musthaq A",
  "style": "dist/uxiora.css",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "css",
    "scss",
    "utility-css",
    "css-framework",
    "frontend",
    "design-system",
    "responsive",
    "uxiora"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uiKit2026/uxiora.git"
  },
  "homepage": "https://github.com/uiKit2026/uxiora",
  "bugs": {
    "url": "https://github.com/uiKit2026/uxiora/issues"
  },
  "main": "dist/uxiora.css",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "sass src/uxiora.scss dist/uxiora.css --style=expanded",
    "build:min": "sass src/uxiora.scss dist/uxiora.min.css --style=compressed",
    "watch": "sass --watch src/uxiora.scss:dist/uxiora.css",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "sass": "^1.102.0"
  }
}